# Server-only Supabase credentials. Configure the same names in Vercel.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Legacy fallback only. Prefer SUPABASE_SECRET_KEY for new Supabase projects.
# SUPABASE_SERVICE_ROLE_KEY=
# A copied wizy.ca environment may use NEXT_PUBLIC_SUPABASE_URL instead of SUPABASE_URL.

# Server-only Resend configuration for admin lead notifications.
RESEND_API_KEY=re_replace_me
SOFTWARE_LEAD_NOTIFICATION_EMAIL=ngochoan1011@gmail.com

# Optional. The sending domain must be verified in Resend.
# SOFTWARE_LEAD_FROM_EMAIL=Wizy Software <notifications@wizy.ca>
